# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:pass@localhost/argus_dev

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# AI 모델 (변경 시 이 파일만 수정)
GRADING_MODEL=claude-sonnet-4-6
EXPLANATION_MODEL=claude-sonnet-4-6

# 신뢰도 게이트
TRUST_THRESHOLD=0.75

# SLA (시간 단위)
SLA_HIGH_RISK_HOURS=12
SLA_NORMAL_HOURS=24

# 교사 인증 (MVP 한정 단순 비밀번호)
TEACHER_PASSWORD=your-secret-password

# 프론트엔드 (Vite)
VITE_API_BASE=http://localhost:8000/api/v1
