# =============================================================
# Argus — 프로덕션 환경변수 템플릿
# 사용법: cp .env.example .env  →  값 채우기  →  bash deploy/setup.sh
# 주의: .env 파일은 절대 커밋하지 마세요 (.gitignore에 포함됨)
# =============================================================

# -------------------------------------------------------------
# 데이터베이스
# -------------------------------------------------------------
# 형식: postgresql+asyncpg://<user>:<password>@<host>/<dbname>
# 예)   postgresql+asyncpg://argus:비밀번호@localhost/argus
DATABASE_URL=postgresql+asyncpg://user:password@localhost/argus

# -------------------------------------------------------------
# Anthropic Claude API
# LLM_PROVIDER=anthropic 일 때만 필요
# -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------
# LLM 제공자 선택: anthropic | mlx | ollama
# - anthropic : Claude API (클라우드, 추천)
# - mlx       : Apple Silicon 로컬 추론 (MLX, Mac Mini M4 전용)
# - ollama    : 로컬 Ollama 서버
# -------------------------------------------------------------
LLM_PROVIDER=mlx

# AI 모델명 — 절대 코드에 하드코딩 금지, 이 파일에서만 관리
# anthropic 사용 시: claude-sonnet-4-6
# ollama 사용 시:    gemma4:e4b
# mlx 사용 시:       GRADING_MODEL / FEEDBACK_MODEL은 논리명으로 쓰고,
#                    실제 모델 경로는 MLX_GRADING_MODEL_PATH / MLX_FEEDBACK_MODEL_PATH에 둡니다.
GRADING_MODEL=claude-sonnet-4-6
FEEDBACK_MODEL=claude-sonnet-4-6

# -------------------------------------------------------------
# MLX 설정 (LLM_PROVIDER=mlx 시 사용)
# -------------------------------------------------------------
MLX_MODEL_PATH=unsloth/gemma-4-E4B-it-MLX-8bit
# GRADING_MODEL / FEEDBACK_MODEL 별 실제 MLX 모델 경로.
# 비워두면 MLX_MODEL_PATH를 공통으로 사용합니다.
MLX_GRADING_MODEL_PATH=unsloth/gemma-4-E2B-it-MLX-8bit
MLX_FEEDBACK_MODEL_PATH=unsloth/gemma-4-E4B-it-MLX-8bit
# 추론 최대 토큰 수 (수식 풀이 여유 확보)
MLX_MAX_TOKENS=4096

# -------------------------------------------------------------
# Ollama 설정 (LLM_PROVIDER=ollama 시 사용)
# -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# -------------------------------------------------------------
# LLM 타임아웃 (초)
# MLX 로컬 모델은 복잡한 수식 풀이 시 2분+ 소요 가능
# -------------------------------------------------------------
LLM_TIMEOUT_SECONDS=300

# -------------------------------------------------------------
# OCR 엔진 선택: got_ocr | pix2tex | mathpix
# - got_ocr  : GOT-OCR 2.0 파인튜닝 모델 (Mac Mini M4 MPS, 추천)
# - pix2tex  : 오픈소스 LaTeX 수식 특화
# - mathpix  : 상용 API (한국어 + 수식 혼합 강함)
# -------------------------------------------------------------
OCR_MODEL=got_ocr

# GOT-OCR 모델 경로 (OCR_MODEL=got_ocr 시 필수)
# ocr_training/scripts/merge_lora.py 로 생성한 merged 모델 디렉토리
GOT_OCR_MODEL_PATH=/path/to/argus/ocr_training/output/got_ocr_merged

# GOT-OCR 전용 conda 환경 Python 경로 (ADR-027)
# setup.sh 실행 후 출력되는 경로를 그대로 복사하세요
# 예) /opt/homebrew/Caskroom/miniconda/base/envs/argus-gotocr/bin/python
GOT_OCR_WORKER_PYTHON=/opt/homebrew/Caskroom/miniconda/base/envs/argus-gotocr/bin/python

# Mathpix API 인증 (OCR_MODEL=mathpix 시 필수)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# -------------------------------------------------------------
# 채점 신뢰도 게이트
# -------------------------------------------------------------
# 0.75 이상 → 점수 즉시 노출, 피드백만 교사 큐
# 0.75 미만 → 점수 + 피드백 모두 교사 큐
TRUST_THRESHOLD=0.75

# -------------------------------------------------------------
# SLA 마감 (시간 단위)
# -------------------------------------------------------------
SLA_HIGH_RISK_HOURS=12
SLA_NORMAL_HOURS=24

# -------------------------------------------------------------
# 교사 대시보드 인증 (MVP 단순 비밀번호)
# 파일럿 이후 JWT 인증으로 교체 예정
# -------------------------------------------------------------
TEACHER_PASSWORD=강력한-비밀번호로-교체하세요

# -------------------------------------------------------------
# 할루시네이션 배치 검증 주기 (초, 기본 5분)
# -------------------------------------------------------------
HALLUCINATION_BATCH_INTERVAL_SECONDS=300

# -------------------------------------------------------------
# CORS 허용 출처 (콤마 구분)
# 개발: http://localhost:5173
# 프로덕션: Cloudflare Tunnel 도메인 (예: https://argus.yourdomain.com)
# -------------------------------------------------------------
ALLOWED_ORIGINS=https://argus.yourdomain.com

# -------------------------------------------------------------
# 프론트엔드 (Vite 빌드 시 주입)
# 프로덕션: /api/v1  (Nginx가 같은 도메인에서 프록시)
# 개발:     http://localhost:8000/api/v1
# -------------------------------------------------------------
VITE_API_BASE=/api/v1
