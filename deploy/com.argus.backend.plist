<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.argus.backend</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yebin/workSpace/Argus/.venv/bin/uvicorn</string>
    <string>main:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8000</string>
    <string>--workers</string>
    <string>1</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yebin/workSpace/Argus/backend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/yebin/workSpace/Argus/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/yebin/workSpace/Argus/logs/backend.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/yebin/workSpace/Argus/logs/backend-error.log</string>

  <key>ThrottleInterval</key>
  <integer>5</integer>
</dict>
</plist>
