[Unit]
Description=Argus Backend (FastAPI + Uvicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=yebin
WorkingDirectory=/Users/yebin/workSpace/Argus/backend
EnvironmentFile=/Users/yebin/workSpace/Argus/.env
ExecStart=/Users/yebin/workSpace/Argus/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=argus-backend

[Install]
WantedBy=multi-user.target
